# Public client env only — values here are visible in the browser bundle.
# Copy to .env for local overrides (do not commit .env).

VITE_BASE_PATH=/
VITE_APP_PORT=8081

# Keep true until AWS API Gateway is live. Set to false to call VITE_API_URL.
VITE_USE_MOCKS=true

# Future AWS HTTP API (API Gateway + Lambda). Unused while mocks are on.
# VITE_API_URL=https://xxxx.execute-api.us-east-1.amazonaws.com

# Cognito admin app client (public — no secret)
VITE_COGNITO_REGION=us-east-1
VITE_COGNITO_USER_POOL_ID=us-east-1_xxxxxxxx
VITE_COGNITO_CLIENT_ID=
VITE_COGNITO_DOMAIN=kwoka-fitness-dev.auth.us-east-1.amazoncognito.com
