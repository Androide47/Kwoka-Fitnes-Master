# Public client env only — values here are visible in the browser bundle.
# Copy to .env for local overrides (do not commit .env).

# Vite asset/router base. Leave "/" for local; CI sets "/<repo-name>/".
VITE_BASE_PATH=/

# Optional when landing calls a real API:
# VITE_API_URL=https://api.example.com

# Cognito user pool: kwoka-fitness-dev (public app client — no secret)
# Callback URLs: http://localhost:8080/login
#                https://androide47.github.io/Kwoka-Fitnes-Master/login
VITE_COGNITO_REGION=us-east-1
VITE_COGNITO_USER_POOL_ID=us-east-1_xxxxxxxx
VITE_COGNITO_CLIENT_ID=
VITE_COGNITO_DOMAIN=kwoka-fitness-dev.auth.us-east-1.amazoncognito.com
