# Public client env only — values here are visible in the browser/app bundle.
# Copy to .env for local overrides (do not commit .env).

# Backend API used by the mobile app (see constants/config.ts).
EXPO_PUBLIC_API_URL=http://localhost:8000

# Static web base path for GitHub Pages subdirectory deploys.
# Leave empty for local; CI sets "/<repo-name>/app".
# EXPO_BASE_URL=/Kwoka-Fitnes-Master/app

# Cognito user pool: kwoka-fitness-dev (mobile app client — different Client ID from landing)
EXPO_PUBLIC_COGNITO_REGION=us-east-1
EXPO_PUBLIC_COGNITO_USER_POOL_ID=us-east-1_xxxxxxxx
EXPO_PUBLIC_COGNITO_CLIENT_ID=
EXPO_PUBLIC_COGNITO_DOMAIN=kwoka-fitness-dev.auth.us-east-1.amazoncognito.com
